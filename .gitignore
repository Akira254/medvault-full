# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build & cache
/.next/
/out/
/build

# Environment & local secrets (never commit API keys or database credentials)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Prisma local artifacts (keep prisma/schema.prisma and prisma/migrations/)
/prisma/*.db
/prisma/*.db-journal

# Playwright & test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Logs & OS / VS Code files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
*.pem