# Database (PostgreSQL with pg_trgm enabled)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medvault?schema=public"

# Security & Sessions
JWT_SECRET="replace-with-a-64-char-cryptographically-random-secret-key"
ADMIN_JWT_SECRET="replace-with-a-separate-64-char-admin-secret-key"
ADMIN_IDLE_TIMEOUT_MINUTES=10
ADMIN_ABSOLUTE_TIMEOUT_MINUTES=60

# Initial Admin Seed (Only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@medvault.example.com"
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_PASSWORD="ChangeMeImmediately123!"

# App URL & Asset Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_HERO_BG_PATH="/images/hero-bg.jpg"

# Multi-LLM Configuration
DEFAULT_AI_PROVIDER="gemini" # gemini | openai | anthropic | openai_compatible
DEFAULT_AI_MODEL="gemini-2.5-flash"
FALLBACK_AI_PROVIDER="openai"
FALLBACK_AI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""

# Email (SMTP / Resend / SendGrid via SMTP)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASS=""
EMAIL_FROM="MedVault <noreply@medvault.example.com>"
